<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: asked when the user turns on instant notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Ferrowl Bridge: the automation apps that can be connected (their
         names and icons; answers are sent to them alone). -->
    <queries>
        <package android:name="net.dinglisch.android.taskerm" />
        <package android:name="com.arlosoft.macrodroid" />
        <package android:name="com.llamalab.automate" />
    </queries>

    <application
        android:name=".FerrowlApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="Ferrowl"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ferrowl">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Ferrowl's own links (Ferrowl Bridge): ferrowl://open,
                 ferrowl://inbox, ferrowl://compose. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ferrowl" />
            </intent-filter>
            <!-- E-mail links and "send e-mail" from other apps: a draft to
                 check, never sent by itself. -->
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mailto" />
            </intent-filter>
            <!-- Text or files shared to Ferrowl become a new message (files
                 attached). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Microsoft sends the browser back here after signing in. -->
        <activity
            android:name=".OAuthRedirectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="msauth" android:host="com.ferrowl.app" />
            </intent-filter>
        </activity>

        <!-- Lets the camera app write the photo being attached (cache/camera). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Ferrowl Bridge: requests from automation apps (Tasker…). Anyone
             may send them; only apps with a key the user created get an
             answer, and answers go to that app alone. -->
        <receiver
            android:name=".bridge.BridgeReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.ferrowl.app.action.UNREAD" />
                <action android:name="com.ferrowl.app.action.SEARCH" />
                <action android:name="com.ferrowl.app.action.SEND" />
                <action android:name="com.ferrowl.app.action.AGENDA" />
                <action android:name="com.ferrowl.app.action.CONTACTS" />
                <action android:name="com.ferrowl.app.action.DETAILS" />
                <action android:name="com.ferrowl.app.action.ARCHIVE" />
                <action android:name="com.ferrowl.app.action.MARK_READ" />
                <action android:name="com.ferrowl.app.action.MARK_UNREAD" />
            </intent-filter>
        </receiver>
        <!-- The Home Screen widget with the unread mail. -->
        <receiver
            android:name=".widget.UnreadWidget"
            android:exported="false"
            android:label="@string/widget_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_unread" />
        </receiver>
        <!-- The widget's "read" and "archive" buttons. -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />
        <!-- Ferrowl as a Tasker plugin (Locale plugin protocol): its settings
             screen, and the receiver that runs it. -->
        <activity
            android:name=".bridge.TaskerPluginActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Ferrowl"
            tools:ignore="ExportedActivity">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".bridge.TaskerPluginReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" />
            </intent-filter>
        </receiver>
        <!-- "Send" / "Don't send" in the confirmation notification. -->
        <receiver
            android:name=".bridge.BridgeAnswerReceiver"
            android:exported="false" />

        <!-- Receives the "new mail" signal from push.ferrowl.com via Firebase. -->
        <service
            android:name=".push.PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
